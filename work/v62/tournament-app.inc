function startTournament(){
 unlockAudio();if(selected.source==='pad'&&!input.pad){$('menu-error').textContent='Conecte um controle e pressione um botão antes de começar.';return;}
 disconnect();tournament=new DuelTournament({stages:+$('tournament-stages').value,difficulty:selected.difficulty,mapMode:$('tournament-map-mode').value,mapId:selected.mapId,maps:Object.keys(MAPS),rules:selected.rules,player:{kind:selected.characters[0],skin:selected.skins[0],color:selected.colors[0]}});prepareTournamentMatch();
}
function prepareTournamentMatch(){
 const run=tournament,opponent=run.players[run.pending.opponent];selected.characters=[run.player.kind,opponent.kind];selected.skins=[run.player.skin,opponent.skin];selected.colors=[run.player.color,opponent.color];
 game=new Game({mode:'pve',ai:true,difficulty:run.difficulty,characters:[...selected.characters],skins:[...selected.skins],colors:[...selected.colors],rules:{...run.rules},mapId:run.fixedMap});game.start();showGame();paused=true;countdown=0;drawTournamentScreen();
}
function drawTournamentScreen(){
 const run=tournament,done=run.finished;$('match').hidden=true;$('pause').hidden=true;$('round-feedback').classList.remove('visible');$('tournament-duel').hidden=done;$('tournament-results').hidden=!done;
 $('tournament-eyebrow').textContent=done?'TORNEIO ENCERRADO · CLASSIFICAÇÃO FINAL':run.stageName()+' · DUELO '+(run.stage+1)+' DE '+run.stages;
 $('tournament-title').textContent=done?(run.champion===0?'O título é seu.':'Até o próximo corte.'):run.stage?'Mais um passo até o título.':'Seu caminho começa aqui.';
 const cls=CLASSES[run.player.kind].name;$('tournament-caption').textContent=done?'Você terminou em '+run.standings().find(p=>p.id===0).rank+'º de '+run.players.length+' participantes.':cls+' fixo até o fim · '+DIFFICULTIES[run.difficulty].name+' · primeiro a '+run.rules.winningScore+' em cada duelo.';
 if(done){const root=$('tournament-ranking');root.replaceChildren();for(const p of run.standings()){const row=document.createElement('tr');row.className=(p.id===0?'you ':'')+(p.rank===1?'champion':'');const place=document.createElement('td');place.textContent=p.rank+'º';const who=document.createElement('td');who.textContent=p.name;const kind=document.createElement('small');kind.textContent=CLASSES[p.kind].name;who.append(kind);const phase=document.createElement('td');phase.textContent=p.phase;const wins=document.createElement('td');wins.textContent=p.wins;const rounds=document.createElement('td');rounds.textContent=p.roundsFor+' — '+p.roundsAgainst;row.append(place,who,phase,wins,rounds);root.append(row);}}
 else{const root=$('tournament-fighters');root.replaceChildren();for(const id of[0,run.pending.opponent]){const p=run.players[id],card=document.createElement('article');card.className='tournament-fighter';const c=document.createElement('canvas');c.width=180;c.height=180;c.dataset.tournamentPlayer=id;const text=document.createElement('div'),label=document.createElement('small'),name=document.createElement('h3'),kind=document.createElement('p');label.textContent=id?'SEU ADVERSÁRIO':'SEU PERSONAGEM · FIXO';name.textContent=p.name;kind.textContent=CLASSES[p.kind].name;text.append(label,name,kind);card.append(c,text);root.append(card);renderer.drawPortrait(c,p.kind,id?1:0,p.color,clock,p.skin);}
 const select=$('tournament-arena');select.replaceChildren();for(const id of run.maps){const option=document.createElement('option');option.value=id;option.textContent=MAPS[id].name;select.append(option);}select.value=run.maps.includes(selected.mapId)?selected.mapId:run.fixedMap;$('tournament-arena-label').hidden=run.mapMode!=='choose';$('tournament-arena-note').textContent=run.mapMode==='random'?'Uma arena diferente será sorteada ao entrar.':run.mapMode==='fixed'?'ARENA FIXA · '+MAPS[run.fixedMap].name:'Apenas a arena pode mudar entre duelos. Sua classe e as regras continuam.';
 const bracket=$('tournament-bracket');bracket.replaceChildren();for(let stage=0;stage<=run.stage;stage++){const group=document.createElement('section');group.className='tournament-bracket-stage';const heading=document.createElement('h3');heading.textContent=run.stageName(stage);group.append(heading);const matches=run.matches.filter(m=>m.stage===stage);for(const m of matches){const line=document.createElement('div');line.className='tournament-bracket-match'+(m.a===0||m.b===0?' you':'');const names=document.createElement('span'),score=document.createElement('strong');names.textContent=run.players[m.a].name+' × '+run.players[m.b].name;score.textContent=m.score.join(' — ')+' · '+run.players[m.winner].name;line.append(names,score);group.append(line);}if(stage===run.stage){const next=document.createElement('div');next.className='tournament-bracket-match you';next.textContent='VOCÊ × '+run.players[run.pending.opponent].name+' · PRÓXIMO DUELO';group.prepend(next);}bracket.append(group);}}
 if(!$('tournament-screen').open)$('tournament-screen').showModal();clearInputs();
}
function beginTournamentMatch(){if(!tournament||tournament.finished||tournament.started)return;const mapId=tournament.begin($('tournament-arena').value);selected.mapId=mapId;game.configure({mapId,rules:tournament.rules});game.start();$('tournament-screen').close();resetEffects();clearInputs();renderer.snapCamera=true;paused=false;countdown=game.rules.specials?0:1;$('match-meta').textContent=MAPS[mapId].name+' · '+tournament.stageName();canvas.focus({preventScroll:true});presentSpecials(()=>{});}
function finishTournamentMatch(){if(!tournament?.started)return;tournament.complete(game.score[0],game.score[1]);paused=true;clearInputs();if(tournament.finished)drawTournamentScreen();else prepareTournamentMatch();}
$('tournament-fight').onclick=beginTournamentMatch;$('tournament-quit').onclick=()=>returnMenu();$('tournament-new').onclick=()=>{selected.mode='tournament';returnMenu();};$('tournament-menu').onclick=()=>{selected.mode='pve';returnMenu();};$('tournament-screen').addEventListener('cancel',e=>e.preventDefault());
