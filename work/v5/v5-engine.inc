// V5: deterministic round rules and event telemetry. Rendering never changes these values.
const MODES={off:'DESLIGADO',normal:'CAOS',ultra:'CAOS ULTRA'};
const CHAOS=[
 {id:'light',name:'BAIXA GRAVIDADE',group:'gravity',key:'gravity',factor:.6},
 {id:'heavy',name:'PESO DO MUNDO',group:'gravity',key:'gravity',factor:1.5},
 {id:'jump',name:'PULO GIGANTE',group:'jump',key:'jump',factor:1.4},
 {id:'dash',name:'MAIS UM DASH',group:'dash',key:'dashCount',add:1},
 {id:'attack',name:'LÂMINAS VELOZES',group:'attack',key:'attackSpeed',factor:1.3},
 {id:'speed',name:'PÉS LIGEIROS',group:'speed',key:'speed',factor:1.25},
 {id:'arena',name:'SEM ESPAÇO',group:'arena',key:'mapSize',factor:.8},
 {id:'guard',name:'GUARDA PRECISA',group:'guard',key:'parryWindow',factor:.75},
 {id:'recovery',name:'DASH INCANSÁVEL',group:'recovery',key:'dashRecovery',factor:.5},
 {id:'fragile',name:'CHÃO DE VIDRO',group:'platforms'},
 {id:'noSpecial',name:'SÓ NA TÉCNICA',group:'special',key:'specials',value:false},
 {id:'special',name:'PODER IMPACIENTE',group:'special',key:'specialCooldown',factor:.6}
];
const metricPlayer=()=>({rounds:0,attacks:0,whiffs:0,parries:0,parryMisses:0,falls:0,dashDeaths:0,recoveryDeaths:0,clashes:0,specials:0,retreat:0,classes:{}});
const original={};for(const key of['configure','start','resetFighters','step','emit','finish','snapshot','loadSnapshot','adminApply','attack'])original[key]=Game.prototype[key];
Game.prototype.configure=function(o={}){original.configure.call(this,o);if(o.rules)this.baseRules=cleanRules(o.baseRules||o.rules,this.experimental);else this.baseRules??={...this.rules};if(Number.isFinite(o.seed))this.chaosSeed=o.seed>>>0;};
Game.prototype.rebuildRoundRules=function(){this.rules={...this.baseRules};for(const id of this.chaosStack||[]){const m=CHAOS.find(m=>m.id===id);if(!m?.key)continue;this.rules[m.key]=m.value??(m.add?this.rules[m.key]+m.add:this.rules[m.key]*m.factor);}this.map=makeMap(this.mapId,this.rules.mapSize,this.mapSource);this.routeCache=new Map();if(this.chaosStack?.includes('arena'))this.safeArenaSpawns();if(this.chaosStack?.includes('fragile'))for(const p of this.map.platforms){if(!p.solid&&!p.wallTop&&!this.map.spawns.some(s=>s.x>=p.x&&s.x<=p.x+p.w&&Math.abs(s.y-p.y)<8))p.fragile={delay:.65,respawn:3.5};}};

Game.prototype.safeArenaSpawns=function(){const map=this.map,used=[];for(const spawn of map.spawns){const r=C.radius+2,candidates=[];for(const p of map.platforms){if(p.w<r*2||p.fragile)continue;for(const x of[clamp(spawn.x,p.x+r,p.x+p.w-r),p.x+r,p.x+p.w-r,p.x+p.w/2]){const q={x,y:p.y};if(map.walls.some(w=>x+r>w.x&&x-r<w.x+w.w&&q.y-C.bodyBottom+r>w.y&&q.y-C.bodyTop-r<w.y+w.h))continue;if(used.some(a=>Math.abs(a.y-q.y)<C.bodyTop&&Math.abs(a.x-x)<r*2+2))continue;candidates.push(q);}}candidates.sort((a,b)=>Math.hypot(a.x-spawn.x,a.y-spawn.y)-Math.hypot(b.x-spawn.x,b.y-spawn.y));const q=candidates[0];if(q)Object.assign(spawn,q);used.push({...spawn});}};

Game.prototype.rollChaos=function(){const mode=this.baseRules.chaos;if(mode==='off'){this.chaosStack=[];this.chaosNew=null;return;}const used=new Set((this.chaosStack||[]).map(id=>CHAOS.find(m=>m.id===id)?.group));let pool=CHAOS.filter(m=>mode==='ultra'?!used.has(m.group):m.id!==this.chaosNew);if(!this.baseRules.specials)pool=pool.filter(m=>m.group!=='special');if(!this.mapSource.platforms.some(p=>!p.solid&&!this.mapSource.spawns.some(s=>s.x>=p.x&&s.x<=p.x+p.w&&Math.abs(s.y-p.y)<8)))pool=pool.filter(m=>m.id!=='fragile');this.chaosState=((this.chaosState||1)*1664525+1013904223)>>>0;const m=pool[Math.floor(this.chaosState/4294967296*pool.length)];this.chaosNew=m?.id||null;if(mode==='normal')this.chaosStack=[];if(m)this.chaosStack.push(m.id);};
Game.prototype.resetFighters=function(preserve=false){if(!this.v5Started||this.loadingV5)return original.resetFighters.call(this,preserve);const fractions=preserve&&this.baseRules.persistSpecial?this.fighters.map(f=>clamp(f.specialCharge/this.rules.specialCooldown,0,1)):[0,0];this.rollChaos();if(this.baseRules.chaos==='off')this.rules={...this.baseRules};else this.rebuildRoundRules();original.resetFighters.call(this,false);this.fighters.forEach((f,i)=>{f.specialCharge=fractions[i]*this.rules.specialCooldown;this.metrics.players[i].classes[f.kind]=(this.metrics.players[i].classes[f.kind]||0)+1;});this.roundTrace={clash:-100,parry:[-100,-100],near:[-100,-100],attacks:[-100,-100]};this.lastHighlight=null;this.lastImpact=null;this.introRemaining=this.baseRules.chaos==='off'?0:4.1;if(this.introRemaining)this.phase='roundIntro';};
Game.prototype.start=function(o){this.v5Started=false;original.start.call(this,o);this.metrics={players:[metricPlayer(),metricPlayer()],winner:null};this.chaosStack=[];this.chaosNew=null;this.chaosState=this.chaosSeed??((Math.random()*4294967296)>>>0);this.v5Started=true;this.resetFighters();};
Game.prototype.attack=function(id){const ok=original.attack.call(this,id);if(ok)this.fighters[id].nearCandidate=null;return ok;};
Game.prototype.emit=function(type,data={}){const m=this.metrics,t=this.roundTrace,id=data.id;let extra={};if(m){const p=m.players[id];if(type==='windup'&&p){p.attacks++;if(t)t.attacks[id]=this.time;}if(type==='whiff'&&p){p.whiffs++;const f=this.fighters[id],n=f.nearCandidate;if(n){if(t)t.near[n.id]=this.time;original.emit.call(this,'nearMiss',{...n,attacker:id,kind:f.kind});f.nearCandidate=null;}}if(type==='parryMiss'&&p)p.parryMisses++;if(type==='parry'&&p){p.parries++;if(t)t.parry[id]=this.time;}if(type==='special'&&p&&this.fighters[id].ultMode!=='boxerRush')p.specials++;if(type==='clash'){m.players.forEach(p=>p.clashes++);if(t)t.clash=this.time;}if(type==='matchEnd')m.winner=data.winner;}
 if(Number.isInteger(id)&&this.fighters?.[id])extra={kind:this.fighters[id].kind,x:this.fighters[id].x,y:this.fighters[id].y-body(this.fighters[id]).center};original.emit.call(this,type,{...extra,...data});if(['round','roundGo'].includes(type)&&this.phase==='playing'&&this.rules.winningScore>1&&this.score.some(n=>n===this.rules.winningScore-1))original.emit.call(this,'matchPoint');};
Game.prototype.deathInfo=function(a,d){const state=d.state,unblockable=a&&(a.state==='ultCharge'||a.breakAttackId&&a.breakAttackId===a.attackId),cause=state==='recovery'?'ABERTURA':state==='parry'?(unblockable?'GUARDA ROMPIDA':'FORA DA GUARDA'):state==='parryRecovery'?'TARDE DEMAIS':state==='stunned'&&this.time-(this.roundTrace?.parry[1-d.id]??-100)<1.2?'PUNIDO':'CORTE LIMPO';const dash=d.dashRemaining>0||['dash','slide'].includes(state),air=!d.grounded;const p=this.metrics?.players[d.id];if(p){if(dash)p.dashDeaths++;if(state==='recovery')p.recoveryDeaths++;}return{cause,state,dash,air,kind:a?.kind||d.kind,victim:d.id,angle:a?.attackAim||0,contours:a?slash(a,this.map.walls).points.map(p=>({...p})):[]};};
Game.prototype.finish=function(winner,reason,data={}){if(this.phase!=='playing')return;const descriptions={ABERTURA:'O ataque errado deixou sua recuperação aberta.','FORA DA GUARDA':'O golpe veio por fora da direção protegida.','TARDE DEMAIS':'O parry terminou antes do golpe.','GUARDA ROMPIDA':'O especial atravessou sua defesa.',PUNIDO:'O parry abriu espaço para o contra-ataque.',QUEDA:'Queda fora da arena.',TROCA:'Os dois caíram no mesmo instante.'};if(descriptions[data.cause])reason=descriptions[data.cause];const t=this.roundTrace||{attacks:[-100,-100],parry:[-100,-100],near:[-100,-100],clash:-100},decider=this.score.every(n=>n===this.rules.winningScore-1),tags=[];if(winner<0)tags.push('TROCA');if(Math.abs(t.attacks[0]-t.attacks[1])<.13&&this.time-Math.max(...t.attacks)<.65)tags.push('POR UM INSTANTE');if(winner>=0&&this.time-t.parry[winner]<1.2)tags.push('CONTRA-ATAQUE');if(data.dash)tags.push('NO DASH');if(data.air)tags.push('NO AR');if(this.time-t.clash<.9)tags.push('DEPOIS DO CLASH');if(winner>=0&&this.time-t.near[winner]<1.5)tags.push('POR UM FIO');if(decider)tags.push('TUDO OU NADA');this.lastHighlight=tags.length?{tags,weight:tags.length+(decider?4:0)+(winner<0?2:0),round:this.round}:null;if(winner>=0&&this.metrics)this.metrics.players[winner].rounds++;this.lastImpact={...data,cause:data.cause||(winner<0?'TROCA':'CORTE LIMPO')};original.finish.call(this,winner,reason,{...data,highlight:this.lastHighlight,cause:data.cause||(winner<0?'TROCA':'CORTE LIMPO')});};
Game.prototype.step=function(dt,inputs=[]){if(this.phase==='roundIntro'){if(!(dt>0))return;this.introRemaining=Math.max(0,this.introRemaining-dt);if(!this.introRemaining){this.phase='playing';this.emit('roundGo');}return;}if(this.phase==='playing'&&this.hitstop<=0&&dt>0){for(const f of this.fighters)if(!f.dead&&f.vx*(this.fighters[1-f.id].x-f.x)<-20)this.metrics.players[f.id].retreat+=dt;}return original.step.call(this,dt,inputs);};
Game.prototype.snapshot=function(){return{...original.snapshot.call(this),baseRules:{...this.baseRules},chaosStack:[...(this.chaosStack||[])],chaosNew:this.chaosNew??null,chaosState:this.chaosState??1,introRemaining:this.introRemaining||0,metrics:JSON.parse(JSON.stringify(this.metrics||{players:[metricPlayer(),metricPlayer()],winner:null})),roundTrace:JSON.parse(JSON.stringify(this.roundTrace||{})),lastHighlight:this.lastHighlight||null,lastImpact:this.lastImpact||null};};
Game.prototype.loadSnapshot=function(s){if(s?.version!==50)return false;this.loadingV5=true;const ok=original.loadSnapshot.call(this,s);this.loadingV5=false;if(!ok)return false;for(const key of['baseRules','chaosStack','chaosNew','chaosState','introRemaining','metrics','roundTrace','lastHighlight','lastImpact'])this[key]=JSON.parse(JSON.stringify(s[key]));this.v5Started=true;this.rebuildRoundRules();s.platformStates?.forEach((p,i)=>Object.assign(this.map.platforms[i]||{},p));this.updatePlatforms(this.time,false);return true;};
Game.prototype.adminApply=function(change){if(change.action==='refill')return original.adminApply.call(this,change);const saved={metrics:this.metrics,stack:[...this.chaosStack],mode:this.baseRules.chaos,state:this.chaosState,new:this.chaosNew,trace:this.roundTrace};const cfg={...change,rules:change.rules||this.baseRules};this.chaosSeed=saved.state;original.adminApply.call(this,cfg);this.metrics=saved.metrics;this.chaosState=saved.state;if(this.baseRules.chaos===saved.mode){this.chaosStack=saved.stack;this.chaosNew=saved.new;this.rebuildRoundRules();original.resetFighters.call(this,false);if(Array.isArray(change.positions))this.fighters.forEach((f,i)=>{for(const k of['x','y'])if(Number.isFinite(change.positions[i]?.[k])){f[k]=change.positions[i][k];f.grounded=false;f.platform=-1;}});}this.phase=this.score.some(n=>n>=this.rules.winningScore)?'matchEnd':this.introRemaining?'roundIntro':'playing';if(this.phase==='matchEnd')this.metrics.winner=this.score.findIndex(n=>n>=this.rules.winningScore);};
