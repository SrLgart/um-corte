function updateV5UI(drawn){const intro=!inMenu&&!lab.viewGame&&drawn.phase==='roundIntro';$('chaos-intro').hidden=!intro||drawn.introRemaining<=3;if(intro){const name=DuelCore.CHAOS.find(m=>m.id===drawn.chaosNew)?.name||'TODOS OS MODIFICADORES ATIVOS';$('chaos-title').textContent=name;$('chaos-subtitle').textContent=drawn.baseRules.chaos==='ultra'?'CAOS ULTRA · ACUMULA A CADA ROUND':'VALE SOMENTE NESTE ROUND';}const mods=drawn.chaosStack||[];$('chaos-active').hidden=inMenu||!mods.length;$('chaos-active').textContent=(drawn.baseRules.chaos==='ultra'?'ULTRA · ':'CAOS · ')+mods.map(id=>DuelCore.CHAOS.find(m=>m.id===id).name).join(' / ');const available=!!lab.bestReplay&&!lab.viewGame,onlineBusy=selected.mode==='online'&&game.phase!=='matchEnd';$('highlight-button').hidden=inMenu||!available;$('highlight-button').disabled=onlineBusy;$('highlight-button').textContent=onlineBusy?'★ MOMENTO GUARDADO · REVER AO FINAL':'★ MOMENTO DECISIVO · REVER ÚLTIMO INSTANTE';$('session-button').disabled=selected.mode==='online'&&!inMenu&&game.phase!=='matchEnd';}
function drawSession(){session.sync();const root=$('session-values');root.replaceChildren();const rows=[['wins','Vitórias'],['rounds','Rounds vencidos'],['bestStreak','Maior sequência de vitórias'],['classes','Classe mais utilizada'],['parries','Parries realizados'],['attacks','Ataques'],['whiffs','Ataques errados'],['falls','Quedas'],['dashDeaths','Mortes durante dash'],['recoveryDeaths','Mortes em recovery'],['clashes','Clashes'],['specials','Especiais usados'],['parryMisses','Parries sem contato'],['retreat','Tempo recuando']];for(const[k,name]of rows){const row=document.createElement('div');const label=document.createElement('span');label.textContent=name;row.append(label);session.players.forEach(p=>{const value=document.createElement('strong');value.textContent=k==='classes'?(CLASSES[Object.keys(p.classes).sort((a,b)=>p.classes[b]-p.classes[a])[0]]?.name||'—'):k==='retreat'?p[k].toFixed(1)+' s':p[k];row.append(value);});root.append(row);}const awards=$('session-awards');awards.replaceChildren();for(const award of session.awards()){const card=document.createElement('article'),who=document.createElement('small'),title=document.createElement('strong'),value=document.createElement('span');who.textContent=award.player;title.textContent=award.title;value.textContent=award.value+' '+award.unit;card.append(who,title,value);awards.append(card);}$('session-empty').hidden=!!session.awards().length;}
let statsResume=false;
function openSession(){if(selected.mode==='online'&&!inMenu&&game.phase!=='matchEnd')return;statsResume=!inMenu&&!paused&&selected.mode!=='online';if(statsResume)paused=true;clearInputs();drawSession();$('session-stats').showModal();}
$('session-button').onclick=$('match-stats').onclick=openSession;$('session-close').onclick=()=>$('session-stats').close();$('session-stats').addEventListener('close',()=>{if(statsResume)paused=false;statsResume=false;clearInputs();});$('session-reset').onclick=()=>{session.clear(session.match);lab.bestReplay=null;drawSession();};
$('highlight-button').onclick=()=>{if(!lab.bestReplay||selected.mode==='online'&&game.phase!=='matchEnd')return;lab.savedClip=lab.clip;lab.clip=lab.bestReplay;openReplay();};
$('graphics-quality').value=renderer.lighting.settings.quality;$('graphics-shadows').checked=renderer.lighting.settings.shadows;$('graphics-quality').onchange=()=>{renderer.lighting.settings.quality=$('graphics-quality').value;renderer.lighting.save();};$('graphics-shadows').onchange=()=>{renderer.lighting.settings.shadows=$('graphics-shadows').checked;renderer.lighting.save();};
