 fatalFrame(game,effects){const f=effects.fatal;if(!f||f.age>.66)return;const c=this.ctx;c.save();const alpha=Math.max(0,1-f.age/.38);if(f.contours?.length){c.globalAlpha=alpha*.45;this.path(f.contours.map(p=>[p.x,p.y]),'#ffefd0');c.globalAlpha=alpha;this.path(f.contours.map(p=>[p.x,p.y]),null,'#fff7dd',1.4);}const radius=45+Math.min(1,f.age/.15)*55;if(f.age<.22&&f.cause!=='QUEDA'){c.globalAlpha=Math.max(0,1-f.age/.22);const a=f.angle-.7;this.line({x:f.x-Math.cos(a)*radius,y:f.y-Math.sin(a)*radius},{x:f.x+Math.cos(a)*radius,y:f.y+Math.sin(a)*radius},'#fff9e6',2);this.line({x:f.x-8,y:f.y+12},{x:f.x+8,y:f.y-12},'#fff9e6',1);}
  c.globalAlpha=Math.min(1,(.66-f.age)*5);const x=DuelCore.clamp(f.x,65,game.map.width-65),y=Math.max(50,Math.min(game.map.height-30,f.y-105));c.font='bold 12px monospace';c.textAlign='center';const width=c.measureText(f.cause).width+22;c.fillStyle='#101624d9';c.fillRect(x-width/2,y-13,width,23);c.fillStyle='#f1e4c6';c.fillText(f.cause,x,y+2);c.restore();
