const DECOR={bell:{name:'Sino',w:62,h:78},lantern:{name:'Lanterna',w:24,h:38},bamboo:{name:'Bambu',w:15,h:135},flag:{name:'Bandeira',w:70,h:86},vase:{name:'Vaso',w:32,h:42}};
function cleanDecor(list=[],width=1280,height=720){if(!Array.isArray(list)||list.length>40)throw Error('Use até 40 objetos decorativos.');return list.map((p,i)=>{if(!DECOR[p?.type]||!Number.isFinite(p.x)||!Number.isFinite(p.y)||p.x<0||p.x>width||p.y<0||p.y>height)throw Error('Objeto decorativo inválido.');return{type:p.type,x:p.x,y:p.y,id:'prop'+i};});}
const WEATHER=['none','leaves','petals','rain','snow','embers'];
MAPS.bells={name:'Pátio dos Sinos',description:'Um sino ancestral entre passarelas e pilares. Cada golpe ecoa.',theme:'tower',weather:'petals',platforms:[{x:40,y:615,w:1200,solid:true},{x:160,y:400,w:270},{x:850,y:400,w:270},{x:540,y:295,w:200}],walls:[{x:70,y:250,w:28,h:365},{x:1182,y:250,w:28,h:365}],spawns:[{x:340,y:615},{x:940,y:615}],decor:[{type:'bell',x:640,y:467},{type:'lantern',x:270,y:335},{type:'lantern',x:1010,y:335},{type:'vase',x:1150,y:573}]};
