const v6original={};for(const k of['resetFighters','step','emit','finish','snapshot','loadSnapshot','adminApply'])v6original[k]=Game.prototype[k];
Game.prototype.resetFighters=function(...args){v6original.resetFighters.apply(this,args);this.propStates=(this.map.decor||[]).map(()=>({hitAt:-100,side:1,broken:false,attacks:[-1,-1]}));};
Game.prototype.touchProps=function(){const props=this.map.decor||[];for(let i=0;i<props.length;i++){const p=props[i],state=this.propStates[i],d=DECOR[p.type],scale=this.map.scale||1;if(!state||state.broken)continue;const x=p.x*scale,y=p.y*scale;for(const f of this.fighters){if(f.dead||state.attacks[f.id]===f.attackId)continue;const poly=slash(f,this.map.walls).points;if(!poly.length||!polygonSegment(poly,{x,y:y+6},{x,y:y+d.h-6},d.w/2))continue;state.attacks[f.id]=f.attackId;state.hitAt=this.time;state.side=f.x<x?1:-1;state.broken=['lantern','bamboo','vase'].includes(p.type);this.emit('propHit',{index:i,prop:p.type,x,y:y+d.h/2,side:state.side});}}};
Game.prototype.step=function(dt,inputs){const active=this.phase==='playing'&&this.hitstop<=0;v6original.step.call(this,dt,inputs);if(active&&this.phase==='playing')this.touchProps();};
Game.prototype.finish=function(winner,reason,data={}){const finisher=this.mode!=='training'&&winner>=0&&this.score[winner]+1>=this.rules.winningScore;v6original.finish.call(this,winner,reason,{...data,finisher});if(finisher&&this.phase==='roundEnd')this.roundTimer+=.65;};
Game.prototype.snapshot=function(){return{...v6original.snapshot.call(this),propStates:JSON.parse(JSON.stringify(this.propStates||[]))};};
Game.prototype.loadSnapshot=function(s){if(!v6original.loadSnapshot.call(this,s))return false;this.propStates=JSON.parse(JSON.stringify(s.propStates||[]));return true;};
Game.prototype.adminApply=function(change){if(change.action==='preview'){if(['idle','tense','guard','perfect','finisher','stop'].includes(change.animation)&&[0,1].includes(change.id))this.emit('preview',{animation:change.animation,id:change.id});return;}return v6original.adminApply.call(this,change);};
function cleanPreset(data){if(data?.format!=='um-corte-preset'||data.version!==1||typeof data.name!=='string'||!data.name.trim()||data.name.length>40||!data.rules||typeof data.rules!=='object')throw Error('Preset inválido.');for(const k of Object.keys(DEFAULT_RULES)){const v=data.rules[k];if(k==='chaos'){if(!Object.hasOwn(MODES,v))throw Error('Modo Caos inválido.');}else if(typeof DEFAULT_RULES[k]==='boolean'){if(typeof v!=='boolean')throw Error('Regra inválida: '+k);}else if(!Number.isFinite(v)||v<RULES[k].min||!RULES[k].unbounded&&v>RULES[k].max||(RULES[k].integer||k==='dashCount')&&!Number.isSafeInteger(v))throw Error('Valor inválido: '+RULES[k].name);}return{format:'um-corte-preset',version:1,name:data.name.trim(),rules:cleanRules(data.rules)};}
