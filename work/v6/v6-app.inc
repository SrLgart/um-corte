const menuFX=new DuelMenuFX({active:()=>inMenu&&!$('map-editor').open,sound:()=>{unlockAudio();sfx.play('swing',{kind:'assassin'});},reduced:()=>renderer.reduced});
let customPresets=[],pendingPreset=null;try{customPresets=JSON.parse(localStorage.getItem('um-corte-presets')||'[]').map(DuelCore.cleanPreset).slice(0,30);}catch{}
function presetList(){const el=$('preset-library');el.replaceChildren();for(let i=0;i<customPresets.length;i++){const o=document.createElement('option');o.value=i;o.textContent=customPresets[i].name;el.append(o);}for(const id of['preset-save','preset-load','preset-import','preset-accept'])$(id).disabled=configLocked();}
function savePresets(){try{localStorage.setItem('um-corte-presets',JSON.stringify(customPresets));}catch{$('preset-status').textContent='Não foi possível salvar neste navegador. Você pode exportar o arquivo.';}}
function currentPreset(){return DuelCore.cleanPreset({format:'um-corte-preset',version:1,name:$('preset-name').value.trim()||'Meu duelo',rules:{...selected.rules}});}
function reviewPreset(p){pendingPreset=p;$('preset-review').hidden=false;$('preset-summary').textContent=p.name+' — '+Object.entries(p.rules).filter(([k,v])=>v!==DEFAULT_RULES[k]).map(([k,v])=>RULES[k]?RULES[k].name+': '+ruleValue(k,v):k==='chaos'?'Caos: '+DuelCore.MODES[v]:({airDash:'Dash aéreo',specials:'Especiais',persistSpecial:'Carga persistente'})[k]+': '+(v?'ON':'OFF')).join(' · ');if(Object.entries(p.rules).every(([k,v])=>v===DEFAULT_RULES[k]))$('preset-summary').textContent=p.name+' — Regras padrão. A arena e os personagens não serão alterados.';}
$('preset-save').onclick=()=>{if(configLocked())return;const p=currentPreset(),i=customPresets.findIndex(q=>q.name===p.name);if(i>=0)customPresets[i]=p;else if(customPresets.length<30)customPresets.push(p);else{$('preset-status').textContent='Limite de 30 presets. Use o nome de um existente para substituí-lo.';return;}savePresets();presetList();$('preset-status').textContent='Preset salvo: '+p.name;};
$('preset-load').onclick=()=>{if(!configLocked()&&customPresets[$('preset-library').value])reviewPreset(customPresets[$('preset-library').value]);};
$('preset-export').onclick=()=>{const p=currentPreset(),url=URL.createObjectURL(new Blob([JSON.stringify(p,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download=p.name.replace(/[^a-z0-9_-]/gi,'-')+'.umcorte-preset.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),5000);};
$('preset-import').onclick=()=>{if(!configLocked())$('preset-file').click();};$('preset-file').onchange=async()=>{const f=$('preset-file').files[0];try{if(!f)return;if(f.size>30000)throw Error('O preset deve ter até 30 KB.');reviewPreset(DuelCore.cleanPreset(JSON.parse(await f.text())));}catch(e){$('preset-status').textContent=e.message;}$('preset-file').value='';};
$('preset-accept').onclick=()=>{if(!pendingPreset||configLocked())return;selected.rules={...pendingPreset.rules};$('preset-name').value=pendingPreset.name;$('preset-review').hidden=true;pendingPreset=null;presetOverride=true;rulesChanged();};$('preset-cancel').onclick=()=>{pendingPreset=null;$('preset-review').hidden=true;};presetList();
$('graphics-reduced').checked=!!renderer.lighting.settings.reduced;$('graphics-reduced').onchange=()=>{renderer.lighting.settings.reduced=$('graphics-reduced').checked;renderer.lighting.save();};
